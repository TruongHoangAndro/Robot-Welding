<?xml version="1.0"?>
<!-- Semantic model of the cell v2 (awm_cell_v2.urdf.xacro).

     Collision rules (TST-002 Rev 0.3 draft F4 / F9, DES-001 Rev 0.6 draft §5.4, B-04):
     - Only pairs that can never change their relative pose are disabled: the UR vendor list (ur_srdf) and the rigid
       body wrist_3_link + head links (all joined by fixed joints).
     - No entry exists between any head link (head_mount, head_body, nozzle_body, nozzle_tip, conduit) and the part,
       holders, jig or any other cell object. Those are world objects of the planning scene (cell scene manifest,
       D19), so an SRDF entry for them is impossible by construction; test_cell_v2.py checks it anyway.
     - Padding (3 mm on every link except nozzle_tip) is applied by the cell_scene_loader node of awm_bringup. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="awm_cell_v2">
  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>
  <xacro:ur_srdf/>

  <!-- 6 robot joints, TCP = tcp_laser (planning, Cartesian moves). -->
  <group name="laser_arm">
    <chain base_link="base_link" tip_link="tcp_laser"/>
  </group>
  <!-- 7th joint (CP-20). Phase 1: never interpolated together with the arm (Modes B / C, ADR-11). -->
  <group name="positioner">
    <joint name="positioner_joint"/>
  </group>

  <!-- Home (Assumption): beam axis down, tcp_laser 219 mm above the base_link plane; equals
       config/initial_positions_v2.yaml. -->
  <group_state name="home" group="laser_arm">
    <joint name="shoulder_pan_joint" value="0.0"/>
    <joint name="shoulder_lift_joint" value="-1.5708"/>
    <joint name="elbow_joint" value="1.0"/>
    <joint name="wrist_1_joint" value="-1.0"/>
    <joint name="wrist_2_joint" value="-1.5708"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>
  <group_state name="zero" group="positioner">
    <joint name="positioner_joint" value="0.0"/>
  </group_state>

  <!-- Rigid body: wrist_3_link and the head links never move relative to each other. wrist_3_link <-> head link =
       "Adjacent" (parent / child through the geometry-less flange / tool0); head <-> head = "Rigid". -->
  <xacro:property name="rigid_tool" value="${['wrist_3_link', 'head_mount', 'head_body', 'nozzle_body', 'nozzle_tip', 'conduit']}"/>
  <xacro:macro name="awm_disable_rigid" params="links">
    <xacro:if value="${len(links) > 1}">
      <xacro:macro name="awm_disable_first" params="first others">
        <xacro:if value="${len(others) > 0}">
          <disable_collisions link1="${first}" link2="${others[0]}"
                              reason="${'Adjacent' if first == 'wrist_3_link' else 'Rigid'}"/>
          <xacro:awm_disable_first first="${first}" others="${others[1:]}"/>
        </xacro:if>
      </xacro:macro>
      <xacro:awm_disable_first first="${links[0]}" others="${links[1:]}"/>
      <xacro:awm_disable_rigid links="${links[1:]}"/>
    </xacro:if>
  </xacro:macro>
  <xacro:awm_disable_rigid links="${rigid_tool}"/>
</robot>
