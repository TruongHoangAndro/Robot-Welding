<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="awm_cell">
  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>
  <xacro:ur_srdf/>

  <!-- Planning group of the offline chain: TCP = MIG wire tip. -->
  <group name="weld_arm">
    <chain base_link="base_link" tip_link="tcp_mig"/>
  </group>
  <!-- Same chain, global IK search (kinematics.yaml): used only for compute_ik. -->
  <group name="weld_arm_search">
    <chain base_link="base_link" tip_link="tcp_mig"/>
  </group>
  <group_state name="home" group="weld_arm">
    <joint name="shoulder_pan_joint" value="0.0"/>
    <joint name="shoulder_lift_joint" value="-1.5708"/>
    <joint name="elbow_joint" value="1.5708"/>
    <joint name="wrist_1_joint" value="-1.5708"/>
    <joint name="wrist_2_joint" value="-1.5708"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>

  <!-- Only geometric neighbours are excluded. The torch is checked against the cell, the part and
       the arm (no blanket allowances, fixes demo F07). -->
  <disable_collisions link1="torch_mig" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="torch_mig" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="pismo_frame" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="pismo_frame" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="pismo_frame" link2="fixture_block" reason="Adjacent"/>
  <disable_collisions link1="fixture_block" link2="base_link_inertia" reason="Never"/>
  <disable_collisions link1="pismo_frame" link2="shoulder_link" reason="Never"/>
</robot>
