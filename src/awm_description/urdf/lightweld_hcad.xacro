<?xml version="1.0"?>
<!-- H-CAD model of the IPG LightWELD 1000 head on tool0 (Goal 1 G1.1, CP-58 decision 2 "keep as CAD"; DES-001 Rev 0.5
     §5.3, §5.4, ADR-16). Same link and joint names as the H-BOX macro (lightweld_hbox.xacro), so the SRDF / ACM do not
     change: head_mount, head_body, nozzle_body, nozzle_tip, conduit, tcp_laser, each on tool0 by a fixed joint.

     Input: the folder head_dir written by awm_geometry export-head (A18 output, cad-geometry agent), never edited here:
       head.yaml   schema awm_head/0.1, unit mm, frame tool0: beam_axis_tool0, beam_exit_tool0_mm, nozzle_len_mm,
                   tool0_T_tcp_mm (xyz, quat_xyzw), links.<head_body|head_mount>.mesh.file / hull.file
       *.stl       meshes in tool0, mm (scale through units.xacro, the allowed URDF unit statement)
     head_dir must be an absolute folder (launch / xacro arg; no path in source). A missing head.yaml, an empty or
     relative head_dir and a head.yaml with another unit / frame / schema stop xacro with a message. Missing STL files
     are reported by sim_mock.launch.py (awm_bringup.cell_config.check_head_dir), which also checks their SHA-256.

     Geometry:
       head_body, head_mount   visual = full CAD mesh, collision = convex hull (Goal 1: no collision verdict, CP-58;
                               the hull only keeps MoveIt light). Link frame = tool0.
       tcp_laser               position: estimates.tcp.method map / teach_ui (explicit or taught TCP, CP-61) ->
                               head.yaml tool0_T_tcp_mm.xyz; otherwise (automatic beam estimate) beam_exit +
                               nozzle_len_mm * beam_axis (head.yaml rule). nozzle_len_mm = head.yaml value; the xacro
                               arg may only repeat it (|diff| > 1e-6 mm stops xacro, review C1: no silent TCP shift).
                               Rotation = head.yaml tool0_T_tcp_mm quaternion (tool Z = beam direction, checked).
                               Assumption (head.yaml, OI-23): no REF_TCP marker; nozzle is parametric (CP-56, OI-15).
       nozzle_body, nozzle_tip cylinders Ø nozzle_dia on the beam axis, nozzle_len_mm long, ending at tcp_laser; the tip collision stops
                               contact_standoff_mm before tcp_laser (F9), as in H-BOX. Assumption until IPG data (I2).
       conduit                 capsule (dia / len = conduit_dia_mm / conduit_len_mm args, Assumption TST-002 §3.1; the
                               fiber / wire conduit is not in the head CAD) starting at the head cable exit and running
                               outward along the cable axis (G1.8). Cable exit from head.yaml, in this order:
                               (1) cable_exit_tool0_mm + cable_axis_tool0 (export-head keys, g1-11); label from
                                   cable_exit_source: map / null -> explicit, rear_estimate -> rear_estimate;
                               (2) estimates.tcp.geometry_estimate with behind_flange true = the automatic beam estimate
                                   export-head refused because it found the fiber / cable connector end (bug of
                                   2026-11-06): exit = its tcp_tool0_mm - head.yaml nozzle_len_mm * its axis.
                               (3) neither -> the parametric conduit_x/y/z_mm, conduit_r/p/y_deg args (H-BOX defaults,
                                   Assumption; review I4). The source is recorded in <awm_conduit source=.../>.
                               conduit_x/y/z, conduit_r/p/y are used only in case (3) (sim_mock refuses them for hcad). Assumption: the conduit leaves the connector straight for conduit_len_mm. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find awm_description)/urdf/units.xacro"/>
  <xacro:include filename="$(find awm_description)/urdf/rotations.xacro"/>
  <xacro:include filename="$(find awm_description)/urdf/head_conduit.xacro"/>

  <xacro:macro name="awm_lightweld_hcad" params="
      parent head_dir
      nozzle_dia_mm:=20 nozzle_len_mm nozzle_tip_len_mm:=5 contact_standoff_mm:=0.3
      conduit_dia_mm:=30 conduit_len_mm:=300
      conduit_x_mm:=97 conduit_y_mm:=0 conduit_z_mm:=110
      conduit_r_deg:=0 conduit_p_deg:=90 conduit_y_deg:=0">
    <xacro:property name="mm" value="${m_per_mm}"/>
    <xacro:property name="hdir" value="${str(head_dir).strip()}"/>
    <xacro:if value="${not hdir}">
      ${xacro.fatal('head_model:=hcad needs head_dir:=&lt;absolute folder with head.yaml&gt; (e.g. &lt;repo_root&gt;/cell/model/head)')}
    </xacro:if>
    <xacro:unless value="${hdir.startswith('/')}">
      ${xacro.fatal('head_dir must be an absolute folder (got ' + hdir + ')')}
    </xacro:unless>
    <!-- open() inside load_yaml: a missing file stops xacro with "No such file or directory: .../head.yaml". -->
    <xacro:property name="hy" value="${xacro.load_yaml(hdir + '/head.yaml')}" lazy_eval="false"/>
    <xacro:unless value="${hy['unit'] == 'mm' and hy['frame'] == 'tool0' and hy['schema'] == 'awm_head/0.1'}">
      ${xacro.fatal(hdir + '/head.yaml: expected unit mm, frame tool0, schema awm_head/0.1; got unit '
                    + str(hy['unit']) + ', frame ' + str(hy['frame']) + ', schema ' + str(hy['schema']))}
    </xacro:unless>

    <xacro:if value="${hy.get('beam_exit_tool0_mm') is None or hy.get('beam_axis_tool0') is None}">
      ${xacro.fatal(hdir + '/head.yaml: beam_exit_tool0_mm / beam_axis_tool0 missing or null (written by an older '
                    + 'export-head with a map TCP override); re-run awm_geometry export-head')}
    </xacro:if>
    <!-- Beam axis (unit), beam exit and tcp_laser in tool0, mm. -->
    <xacro:property name="ax_raw" value="${[float(v) for v in hy['beam_axis_tool0']]}"/>
    <xacro:property name="ax_n" value="${sqrt(ax_raw[0]**2 + ax_raw[1]**2 + ax_raw[2]**2)}"/>
    <xacro:property name="ax" value="${[v / ax_n for v in ax_raw]}"/>
    <xacro:if value="${hy.get('nozzle_len_mm') is None}">
      ${xacro.fatal(hdir + '/head.yaml: nozzle_len_mm missing; re-run awm_geometry export-head')}
    </xacro:if>
    <xacro:property name="noz" value="${float(hy['nozzle_len_mm'])}"/>
    <xacro:property name="noz_arg" value="${str(nozzle_len_mm).strip()}"/>
    <xacro:if value="${bool(noz_arg) and python.abs(float(noz_arg) - noz) > 1e-6}">
      ${xacro.fatal('nozzle_len_mm:=' + noz_arg + ' differs from head.yaml nozzle_len_mm ' + str(noz) + ' (' + hdir
                    + '/head.yaml): the nozzle length belongs to the TCP record (map / CP-61 teach); leave the arg '
                    + 'empty or re-export the head with the new nozzle length')}
    </xacro:if>
    <xacro:property name="tcp_method" value="${((hy.get('estimates') or dict()).get('tcp') or dict()).get('method')}"/>
    <xacro:property name="tcp_explicit" value="${tcp_method in ('map', 'teach_ui')}"/>
    <xacro:property name="ex_file" value="${[float(v) for v in hy['beam_exit_tool0_mm']]}"/>
    <xacro:property name="tcp" value="${[float(v) for v in hy['tool0_T_tcp_mm']['xyz']] if tcp_explicit
                                       else [ex_file[i] + noz * ax[i] for i in python.range(3)]}"/>
    <!-- Beam exit = start of the parametric nozzle: nozzle_len_mm behind the TCP (map / teach) or the file value. -->
    <xacro:property name="ex" value="${[tcp[i] - noz * ax[i] for i in python.range(3)] if tcp_explicit else ex_file}"/>
    <!-- Automatic estimate (or no method): head.yaml TCP must follow the rule within 1 micrometre (review M4). -->
    <xacro:property name="tcp_rule_tol_mm" value="${10**-3}"/>
    <xacro:property name="tcp_file" value="${[float(v) for v in hy['tool0_T_tcp_mm']['xyz']]}"/>
    <xacro:property name="tcp_rule_err" value="${sqrt((tcp_file[0] - tcp[0])**2 + (tcp_file[1] - tcp[1])**2
                                                + (tcp_file[2] - tcp[2])**2)}"/>
    <xacro:if value="${not tcp_explicit and not tcp_rule_err &lt;= tcp_rule_tol_mm}">
      ${xacro.fatal(hdir + '/head.yaml: tool0_T_tcp_mm.xyz differs from beam_exit_tool0_mm + nozzle_len_mm * '
                    + 'beam_axis_tool0 by ' + str(tcp_rule_err) + ' mm (> ' + str(tcp_rule_tol_mm) + ' mm, method ' + str(tcp_method)
                    + '); re-run awm_geometry export-head')}
    </xacro:if>
    <xacro:property name="tq" value="${[float(v) for v in hy['tool0_T_tcp_mm']['quat_xyzw']]}"/>
    <xacro:awm_quat_rpy q="${tq}" name="tcp_rpy"/>
    <!-- Z column of the tcp rotation must be the beam direction (tool Z = beam, DES-001 §5.3). -->
    <xacro:property name="qn" value="${sqrt(tq[0]**2 + tq[1]**2 + tq[2]**2 + tq[3]**2)}"/>
    <xacro:property name="zc" value="${[2.0 * (tq[0] * tq[2] + tq[3] * tq[1]) / qn**2,
                                        2.0 * (tq[1] * tq[2] - tq[3] * tq[0]) / qn**2,
                                        1.0 - 2.0 * (tq[0]**2 + tq[1]**2) / qn**2]}"/>
    <xacro:unless value="${zc[0] * ax[0] + zc[1] * ax[1] + zc[2] * ax[2] > 1.0 - 1e-9}">
      ${xacro.fatal(hdir + '/head.yaml: tool0_T_tcp_mm Z axis is not beam_axis_tool0')}
    </xacro:unless>

    <!-- Cable exit (point mm, unit outward axis) in tool0, see header. -->
    <xacro:property name="g_est" value="${((hy.get('estimates') or dict()).get('tcp') or dict()).get('geometry_estimate') or dict()}"/>
    <!-- ce_pos = where the point / axis come from; ce_src = recorded label. With the cable keys the label follows
         head.yaml cable_exit_source (g1-11: map -> explicit, rear_estimate -> rear_estimate, absent / null ->
         explicit); same rule as awm_bringup.cell_config.conduit_source. -->
    <xacro:property name="ce_pos" value="${'keys' if hy.get('cable_exit_tool0_mm') is not None
                                           and hy.get('cable_axis_tool0') is not None
                                           else ('estimate' if g_est.get('behind_flange') is True
                                                 and g_est.get('tcp_tool0_mm') is not None
                                                 and g_est.get('beam_axis_tool0') is not None else 'parametric')}"/>
    <xacro:property name="ce_label" value="${hy.get('cable_exit_source')}"/>
    <xacro:if value="${ce_pos == 'keys' and ce_label not in (None, 'map', 'rear_estimate')}">
      ${xacro.fatal(hdir + '/head.yaml: cable_exit_source ' + str(ce_label) + ' unknown (expected map, rear_estimate '
                    + 'or null)')}
    </xacro:if>
    <xacro:property name="ce_src" value="${('rear_estimate' if ce_label == 'rear_estimate' else 'explicit')
                                           if ce_pos == 'keys'
                                           else ('rear_estimate' if ce_pos == 'estimate' else 'parametric')}"/>
    <xacro:property name="ce_a_raw" value="${[float(v) for v in (hy['cable_axis_tool0'] if ce_pos == 'keys'
                                                                  else g_est.get('beam_axis_tool0', [0, 0, 1]))]}"/>
    <xacro:property name="ce_a_n" value="${sqrt(ce_a_raw[0]**2 + ce_a_raw[1]**2 + ce_a_raw[2]**2)}"/>
    <xacro:property name="ce_a" value="${[v / ce_a_n for v in ce_a_raw]}"/>
    <xacro:property name="ce_p" value="${[float(v) for v in hy['cable_exit_tool0_mm']] if ce_pos == 'keys'
                                         else [float(g_est['tcp_tool0_mm'][i]) - float(hy['nozzle_len_mm']) * ce_a[i]
                                               for i in python.range(3)] if ce_pos == 'estimate'
                                         else [0.0, 0.0, 0.0]}"/>
    <!-- Rotation taking +Z to the cable axis (shortest arc; 180 deg about X when the axis is -Z). -->
    <xacro:property name="ce_q" value="${[-ce_a[1], ce_a[0], 0.0, 1.0 + ce_a[2]] if 1.0 + ce_a[2] > 1e-12
                                         else [1.0, 0.0, 0.0, 0.0]}"/>
    <xacro:awm_quat_rpy q="${ce_q}" name="ce_rpy"/>

    <!-- Nozzle split along the beam (s = distance from the beam exit, mm). -->
    <xacro:property name="body_len" value="${noz - float(nozzle_tip_len_mm)}"/>
    <!-- nozzle_len_mm 0 = nozzle part of the CAD (head.py): no parametric nozzle; otherwise it must be longer than its
         tip (review I5). -->
    <xacro:if value="${noz != 0.0 and not body_len > 0.0}">
      ${xacro.fatal('nozzle_len_mm (' + str(noz) + ', head.yaml) must be 0 (nozzle in the CAD) or longer than '
                    + 'nozzle_tip_len_mm (' + str(nozzle_tip_len_mm) + '): nozzle_body would have length '
                    + str(body_len) + ' mm (review I5)')}
    </xacro:if>
    <xacro:property name="tip_len" value="${float(nozzle_tip_len_mm) - float(contact_standoff_mm)}"/>
    <xacro:unless value="${tip_len > 0.0}">
      ${xacro.fatal('nozzle_tip_len_mm (' + str(nozzle_tip_len_mm) + ') must be longer than contact_standoff_mm ('
                    + str(contact_standoff_mm) + '): the nozzle_tip collision would have length ' + str(tip_len)
                    + ' mm (review M5)')}
    </xacro:unless>
    <xacro:property name="noz_r" value="${float(nozzle_dia_mm) / 2.0}"/>

    <xacro:macro name="awm_on_tool0" params="child">
      <joint name="tool0_to_${child}" type="fixed">
        <parent link="${parent}"/>
        <child link="${child}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
    </xacro:macro>

    <xacro:macro name="awm_mesh_link" params="name rgba">
      <xacro:property name="entry" value="${hy['links'][name]}"/>
      <link name="${name}">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="file://${hdir}/${entry['mesh']['file']}" scale="${mm} ${mm} ${mm}"/></geometry>
          <material name="${name}_color"><color rgba="${rgba}"/></material>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry><mesh filename="file://${hdir}/${entry['hull']['file']}" scale="${mm} ${mm} ${mm}"/></geometry>
        </collision>
      </link>
      <xacro:awm_on_tool0 child="${name}"/>
    </xacro:macro>

    <!-- Cylinder of length len_s centred at s_c on the beam axis, link frame = tool0, cylinder Z = beam. -->
    <xacro:macro name="awm_beam_cyl_link" params="name s_c len_s rgba">
      <xacro:property name="c" value="${[ex[i] + float(s_c) * ax[i] for i in python.range(3)]}"/>
      <link name="${name}">
        <visual>
          <origin xyz="${c[0] * mm} ${c[1] * mm} ${c[2] * mm}" rpy="${tcp_rpy[0]} ${tcp_rpy[1]} ${tcp_rpy[2]}"/>
          <geometry><cylinder radius="${noz_r * mm}" length="${float(len_s) * mm}"/></geometry>
          <material name="${name}_color"><color rgba="${rgba}"/></material>
        </visual>
        <collision>
          <origin xyz="${c[0] * mm} ${c[1] * mm} ${c[2] * mm}" rpy="${tcp_rpy[0]} ${tcp_rpy[1]} ${tcp_rpy[2]}"/>
          <geometry><cylinder radius="${noz_r * mm}" length="${float(len_s) * mm}"/></geometry>
        </collision>
      </link>
      <xacro:awm_on_tool0 child="${name}"/>
    </xacro:macro>

    <xacro:awm_mesh_link name="head_mount" rgba="0.45 0.45 0.48 1"/>
    <xacro:awm_mesh_link name="head_body" rgba="0.85 0.85 0.85 1"/>
    <xacro:if value="${noz > 0.0}">
      <xacro:awm_beam_cyl_link name="nozzle_body" s_c="${body_len / 2.0}" len_s="${body_len}"
                               rgba="0.72 0.45 0.20 1"/>
      <xacro:awm_beam_cyl_link name="nozzle_tip" s_c="${body_len + tip_len / 2.0}" len_s="${tip_len}"
                               rgba="0.80 0.20 0.20 1"/>
    </xacro:if>
    <xacro:if value="${noz == 0.0}">
      <!-- nozzle in the head CAD: links kept for the SRDF / ACM, no parametric geometry. -->
      <link name="nozzle_body"/>
      <xacro:awm_on_tool0 child="nozzle_body"/>
      <link name="nozzle_tip"/>
      <xacro:awm_on_tool0 child="nozzle_tip"/>
    </xacro:if>

    <xacro:if value="${ce_src == 'parametric'}">
      <!-- Assumption: no cable exit in head.yaml (automatic beam_axis export) -> parametric conduit args (H-BOX
           defaults, TST-002 §3.1), recorded as source parametric. -->
      <xacro:awm_head_conduit parent="${parent}" dia_mm="${conduit_dia_mm}" len_mm="${conduit_len_mm}"
        x_mm="${conduit_x_mm}" y_mm="${conduit_y_mm}" z_mm="${conduit_z_mm}"
        r_deg="${conduit_r_deg}" p_deg="${conduit_p_deg}" y_deg="${conduit_y_deg}" source="parametric"/>
    </xacro:if>
    <xacro:unless value="${ce_src == 'parametric'}">
      <xacro:awm_head_conduit parent="${parent}" dia_mm="${conduit_dia_mm}" len_mm="${conduit_len_mm}"
        x_mm="${ce_p[0]}" y_mm="${ce_p[1]}" z_mm="${ce_p[2]}"
        r_deg="${ce_rpy[0] / rad_per_deg}" p_deg="${ce_rpy[1] / rad_per_deg}" y_deg="${ce_rpy[2] / rad_per_deg}"
        source="${ce_src}"/>
    </xacro:unless>

    <!-- tcp_laser: on the beam axis at the nozzle end = contact point on the seam (DES-001 §5.3, Assumption until
         IPG data, OI-2 / OI-23). Tool Z = beam direction. -->
    <link name="tcp_laser"/>
    <joint name="tool0_to_tcp_laser" type="fixed">
      <parent link="${parent}"/>
      <child link="tcp_laser"/>
      <origin xyz="${tcp[0] * mm} ${tcp[1] * mm} ${tcp[2] * mm}" rpy="${tcp_rpy[0]} ${tcp_rpy[1]} ${tcp_rpy[2]}"/>
    </joint>
  </xacro:macro>
</robot>
