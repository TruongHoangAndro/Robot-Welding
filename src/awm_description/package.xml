<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>awm_description</name>
  <version>0.1.0</version>
  <description>APLSMN601 D14 cell model: UR5e + MIG torch + Pismo frame + fixture (URDF/xacro, SRDF, MoveIt config).</description>
  <maintainer email="truongxhoang@apillis.com">Truong Hoang</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_moveit_config</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>pick_ik</exec_depend>
  <exec_depend>hardware_interface</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>urdfdom_py</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
