{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v2/program.schema.json",
  "title": "program",
  "description": "D09 program v2 (A61\u2013A64, B-15): one segment per controller with the trajectory exactly as commanded (awm_motion converts deg \u2192 rad for the controllers), hold values of the other axes, weld events only at rest of robot and positioner, context record. Self-contained (B-09). MINOR 2.1 (G1.5, CP-58 / CP-59): controller robot_positioner = one synchronised 7-joint trajectory (positions / velocities / accelerations in the order joint_names.robot then joint_names.positioner, hold_deg empty), positioner_mode on robot_positioner weld segments, collision_checked (required from 2.1; false = kinematic only, every release gate refuses it), optional generator record, event wps_id / preset null = no process assignment (no D06 yet; every release gate refuses it).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_by",
    "created_at",
    "inputs",
    "program_rev",
    "part_no",
    "part_rev",
    "run_id",
    "context",
    "joint_names",
    "home",
    "segments",
    "events",
    "cycle_time_s"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "created_by": {
      "$ref": "common.schema.json#/$defs/created_by"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/created_at"
    },
    "inputs": {
      "$ref": "common.schema.json#/$defs/inputs"
    },
    "program_rev": {
      "$ref": "common.schema.json#/$defs/program_rev"
    },
    "part_no": {
      "type": "string",
      "minLength": 1
    },
    "part_rev": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "context": {
      "$ref": "common.schema.json#/$defs/context_record"
    },
    "joint_names": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "robot",
        "positioner"
      ],
      "properties": {
        "robot": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 6
        },
        "positioner": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "robot_deg",
        "positioner_deg"
      ],
      "properties": {
        "robot_deg": {
          "$ref": "common.schema.json#/$defs/joints6_deg"
        },
        "positioner_deg": {
          "type": "number"
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "controller",
          "kind",
          "seam_id",
          "hold_deg",
          "tcp_speed_mm_s",
          "points"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "pattern": "^G[0-9]{3}$"
          },
          "controller": {
            "type": "string",
            "enum": [
              "robot",
              "positioner",
              "robot_positioner"
            ],
            "description": "robot_positioner (MINOR 2.1): one 7-joint trajectory, robot joints then positioner joint"
          },
          "kind": {
            "type": "string",
            "enum": [
              "air",
              "approach",
              "weld",
              "retract",
              "index",
              "positioner_weld",
              "touch"
            ]
          },
          "seam_id": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/seam_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "hold_deg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "values of the axes of the other controller, constant during this segment"
          },
          "tcp_speed_mm_s": {
            "oneOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "time_from_start_s",
                "positions_deg",
                "velocities_deg_s",
                "accelerations_deg_s2"
              ],
              "properties": {
                "time_from_start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "positions_deg": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 1
                },
                "velocities_deg_s": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 1
                },
                "accelerations_deg_s2": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 1
                }
              }
            },
            "minItems": 2
          },
          "positioner_mode": {
            "type": "string",
            "enum": [
              "sync",
              "C",
              "B"
            ],
            "description": "MINOR 2.1, weld segments of controller robot_positioner: sync = robot and positioner move together (CP-59), C = robot at rest, B = positioner at rest"
          },
          "collision_checked": {
            "type": "boolean",
            "description": "MINOR 2.1: false = this segment was not collision-checked (e.g. joint-interpolated air move in Goal 1)"
          },
          "arc_index": {
            "type": "integer",
            "minimum": 1,
            "description": "MINOR 2.1: arc of the seam (D04 arcs, CP-53) for approach / weld / retract segments"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "controller": {
                  "const": "robot_positioner"
                }
              },
              "required": [
                "controller"
              ]
            },
            "then": {
              "properties": {
                "hold_deg": {
                  "maxItems": 0
                },
                "points": {
                  "items": {
                    "properties": {
                      "positions_deg": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 7,
                        "maxItems": 7
                      },
                      "velocities_deg_s": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 7,
                        "maxItems": 7
                      },
                      "accelerations_deg_s2": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 7,
                        "maxItems": 7
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "controller": {
                  "const": "robot_positioner"
                },
                "kind": {
                  "enum": [
                    "weld",
                    "positioner_weld"
                  ]
                }
              },
              "required": [
                "controller",
                "kind"
              ]
            },
            "then": {
              "required": [
                "positioner_mode"
              ]
            }
          }
        ]
      },
      "minItems": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "type",
          "seam_id",
          "after_segment",
          "wps_id",
          "preset"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^V[0-9]{3}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "WeldStart",
              "WeldEnd"
            ]
          },
          "seam_id": {
            "$ref": "common.schema.json#/$defs/seam_id"
          },
          "after_segment": {
            "type": "string",
            "pattern": "^G[0-9]{3}$"
          },
          "wps_id": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "description": "null (MINOR 2.1 only) = no process assignment yet (no D06); release gates refuse it"
          },
          "preset": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "description": "LightWELD preset number (PLC selects it); null (MINOR 2.1 only) = no process assignment yet"
          }
        }
      }
    },
    "cycle_time_s": {
      "type": "number",
      "minimum": 0
    },
    "collision_checked": {
      "type": "boolean",
      "description": "false = kinematic only, collision not evaluated (Goal 1, CP-58); every release gate refuses it. Required from MINOR 2.1"
    },
    "generator": {
      "type": "object",
      "required": [
        "params",
        "params_sha256"
      ],
      "properties": {
        "params": {
          "type": "object"
        },
        "params_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "description": "program generator record (MINOR 2.1): parameters (Assumptions), source D07, travel speeds and their source, limits used, checks"
    }
  },
  "if": {
    "properties": {
      "schema_version": {
        "const": "2.0"
      }
    }
  },
  "then": {
    "properties": {
      "events": {
        "items": {
          "properties": {
            "wps_id": {
              "type": "string"
            },
            "preset": {
              "type": "integer"
            }
          }
        }
      }
    }
  },
  "else": {
    "required": [
      "collision_checked"
    ]
  }
}
