{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v2/cad_check.schema.json",
  "title": "cad_check",
  "description": "CP-60 cross-check of a job STEP against the cell model (jobs/<job>/cad_check.json): checks 1-6 of the spec; status = worst check; red blocks seam picking and Plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_by",
    "created_at",
    "inputs",
    "status",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "created_by": {
      "$ref": "common.schema.json#/$defs/created_by"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/created_at"
    },
    "inputs": {
      "$ref": "common.schema.json#/$defs/inputs"
    },
    "status": {
      "type": "string",
      "enum": [
        "green",
        "yellow",
        "red"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "green",
              "yellow",
              "red",
              "skipped"
            ]
          },
          "values": {
            "type": "object"
          },
          "tolerance": {
            "type": "object"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "phi_deg": {
      "type": [
        "number",
        "null"
      ],
      "description": "rotation about the axis from the job file to the cell file (theta 0)"
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unassigned_static": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
