{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v2/part.schema.json",
  "title": "part",
  "description": "D03 part record (A14), v2: part frame, mm. `source.component` fixes the shape that every id-based file of the job (edges.json, D20, seams.json) is built from (D20 contract rule 5, review N1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_by",
    "created_at",
    "inputs",
    "part_no",
    "part_rev",
    "source",
    "unit_source",
    "bbox_mm",
    "counts",
    "checks",
    "healed",
    "mesh",
    "brep_cache",
    "edges_file"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "created_by": {
      "$ref": "common.schema.json#/$defs/created_by"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/created_at"
    },
    "inputs": {
      "$ref": "common.schema.json#/$defs/inputs"
    },
    "part_no": {
      "type": "string",
      "minLength": 1
    },
    "part_rev": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_file",
        "step_sha256",
        "component",
        "up_axis"
      ],
      "properties": {
        "step_file": {
          "type": "string",
          "minLength": 1,
          "description": "relative to the job folder (model.step)"
        },
        "step_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "component": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "up_axis": {
          "type": "string",
          "enum": [
            "+X",
            "-X",
            "+Y",
            "-Y",
            "+Z",
            "-Z"
          ]
        }
      }
    },
    "unit_source": {
      "type": "string",
      "enum": [
        "mm",
        "m",
        "inch",
        "unknown"
      ]
    },
    "bbox_mm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "common.schema.json#/$defs/vec3"
        },
        "max": {
          "$ref": "common.schema.json#/$defs/vec3"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solids",
        "shells",
        "faces",
        "edges"
      ],
      "properties": {
        "solids": {
          "type": "integer",
          "minimum": 0
        },
        "shells": {
          "type": "integer",
          "minimum": 0
        },
        "faces": {
          "type": "integer",
          "minimum": 0
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "ok",
          "detail"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "healed": {
      "type": "boolean"
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "linear_deflection_mm",
        "angular_deflection_deg",
        "triangles"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "linear_deflection_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "angular_deflection_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "triangles": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "brep_cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "edges_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
