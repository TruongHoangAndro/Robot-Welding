<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>awm_program</name>
  <version>0.1.0</version>
  <description>APLSMN601 M6 program generator (A61-A64): path (part frame) -> base frame with the active calibration, joint trajectory segments at constant TCP weld speed, WeldStart / WeldEnd events at rest points, program.json per revision.</description>
  <maintainer email="truongxhoang@apillis.com">Truong Hoang</maintainer>
  <license>Proprietary</license>

  <exec_depend>awm_core</exec_depend>
  <exec_depend>awm_path</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>awm_bringup</test_depend>
  <test_depend>awm_cad</test_depend>
  <test_depend>awm_seam</test_depend>
  <test_depend>awm_process</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
